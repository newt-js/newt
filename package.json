{
  "name": "newt-framework",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "web",
    "studio"
  ],
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test",
    "lint": "bun --bun eslint",
    "check-packs": "bun tools/release/check-packs.ts",
    "release:version": "bun tools/release/version.ts",
    "release:publish": "bun tools/release/publish.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "10.12.0",
    "typescript": "7.0.2",
    "@newt-js/cli": "^0.0.0"
  },
  "overrides": {
    "@typescript-eslint/parser": {
      "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "typescript-eslint": {
      "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "@typescript-eslint/eslint-plugin": {
      "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "@typescript-eslint/project-service": {
      "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "@typescript-eslint/tsconfig-utils": {
      "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "@typescript-eslint/type-utils": {
      "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "@typescript-eslint/typescript-estree": {
      "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "@typescript-eslint/utils": {
      "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "ts-api-utils": {
      "typescript": "npm:@typescript/typescript6@6.0.2"
    }
  }
}
