{
  "name": "newt-framework",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test",
    "lint": "bun --bun eslint",
    "check-packs": "bun tools/release/check-packs.ts",
    "release:version": "bun tools/release/version.ts",
    "release:publish": "bun tools/release/publish.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "10.12.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@typescript-eslint/parser": {
      "typescript": "npm:@typescript/typescript6@6.0.2"
    }
  }
}
