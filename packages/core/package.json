{
  "name": "@newt-js/core",
  "version": "0.0.0",
  "description": "newt's core: modules, entities, use cases, domain events with a transactional outbox, and the adapters to keep and serve them, on Bun.",
  "license": "MIT",
  "author": "Angel Romero",
  "homepage": "https://newt-js.github.io/newt/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newt-js/newt.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/newt-js/newt/issues",
  "keywords": [
    "bun",
    "framework",
    "backend",
    "ddd",
    "bounded-contexts",
    "use-cases",
    "domain-events",
    "outbox"
  ],
  "type": "module",
  "files": [
    "src",
    "!**/*.test.ts",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./application": "./src/application/index.ts",
    "./application/testing": "./src/application/testing/index.ts",
    "./database/memory": "./src/adapters/database/memory/index.ts",
    "./files/memory": "./src/adapters/files/memory/index.ts",
    "./cluster/memory": "./src/adapters/cluster/memory/index.ts",
    "./cluster/valkey": "./src/adapters/cluster/valkey/index.ts",
    "./files/local": "./src/adapters/files/local/index.ts",
    "./files/s3": "./src/adapters/files/s3/index.ts",
    "./database/postgres": "./src/adapters/database/postgres/index.ts",
    "./database/mysql": "./src/adapters/database/mysql/index.ts",
    "./database/sqlite": "./src/adapters/database/sqlite/index.ts",
    "./http": "./src/adapters/http/index.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "zod": "4.3.6"
  }
}
