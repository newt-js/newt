{
  "name": "@newt-js/cli",
  "version": "0.0.0",
  "description": "newt's command line: newt init, and newt add for contexts, modules and their pieces, as newt's lint wants them.",
  "license": "MPL-2.0",
  "author": "Angel Romero",
  "homepage": "https://newt-js.github.io/newt/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newt-js/newt.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/newt-js/newt/issues",
  "keywords": [
    "bun",
    "newt",
    "cli",
    "generator",
    "scaffold",
    "ddd"
  ],
  "type": "module",
  "files": [
    "src",
    "!**/*.test.ts",
    "!src/testing",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "newt": "./src/bin.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "devDependencies": {
    "@newt-js/core": "workspace:*",
    "@newt-js/lint": "workspace:*",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.3.6"
  }
}
