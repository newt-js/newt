---
/**
 * newt's logotype: its four letters cut out of different papers, like a ransom note, all of them
 * gruvbox's greens. Brought from the old guide's logotype.
 * `only` draws a single cut-out: the landing flies each on its own.
 */
import '@fontsource/abril-fatface/latin-400.css'
import '@fontsource/bowlby-one/latin-400.css'
import '@fontsource/playfair-display/latin-900-italic.css'
import '@fontsource/rubik-mono-one/latin-400.css'

interface Props { class?: string; only?: number }
const { class: className = '', only } = Astro.props
const word = ['n', 'e', 'w', 't']
const letters = only === undefined ? word.map((_, index) => index) : [only]
---
<span class:list={['newt-logo', className]} role="img" aria-label="newt">
  {letters.map((index) => <span class={`cut cut-${index}`} style={`--i:${index}`} aria-hidden="true">{word[index]}</span>)}
</span>

<style is:global>
  /* Global: the docs draw it too, and each cut-out keeps its paper wherever it is. */
  .newt-logo { position: relative; display: inline-flex; align-items: center; gap: .07em; line-height: 1; letter-spacing: 0; white-space: nowrap; }
  :where(.newt-logo) { font-size: 22px; }
  .newt-logo .cut { display: inline-grid; place-items: center; height: 1.08em; padding: 0 .12em; box-shadow: 0 .03em 0 rgba(0, 0, 0, .18); transform: rotate(var(--turn)) translateY(var(--lift, 0)); }
  .newt-logo .cut-0 { --turn: -5deg; font-family: 'Bowlby One', sans-serif; background: #427b58; color: #fbf1c7; }
  .newt-logo .cut-1 { --turn: 4deg; --lift: -.07em; font-family: 'Playfair Display', serif; font-style: italic; font-weight: 900; background: var(--paper-light, #fbf1c7); color: #427b58; outline: 1px solid #d5c4a1; }
  .newt-logo .cut-2 { --turn: -1deg; --lift: .07em; font-family: 'Rubik Mono One', monospace; font-size: .85em; height: 1.27em; background: #8ec07c; color: #1d2021; }
  .newt-logo .cut-3 { --turn: 6deg; font-family: 'Abril Fatface', serif; background: #79740e; color: #fbf1c7; }

  /* The cut-outs shuffle when the pointer is on them. */
  a:hover > .newt-logo .cut, .newt-logo:hover .cut { animation: newt-shuffle .45s cubic-bezier(.3, 1.6, .5, 1) both; animation-delay: calc(var(--i) * .04s); }
  @keyframes newt-shuffle {
    40% { transform: rotate(calc(var(--turn) * -2.2)) translateY(-.12em) scale(1.08); }
    100% { transform: rotate(var(--turn)) translateY(var(--lift, 0)); }
  }

  @media (prefers-reduced-motion: reduce) { .newt-logo .cut { animation: none !important; } }
</style>

